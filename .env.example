# PiTimeLapse Lab - Environment Variables
# ========================================
#
# This file contains environment variables that can override config.yaml settings.
# This is useful when you want to change paths or ports without editing the main config.
#
# HOW TO USE:
# 1. Copy this file to ".env" (remove the ".example" part)
# 2. Uncomment the lines you want to change (remove the # at the start)
# 3. The app will load these values when it starts
#
# Note: Settings in this file take PRIORITY over config.yaml

# ============================================================================
# PATH OVERRIDES
# ============================================================================

# Where to save captured images (absolute or relative path)
# PITIMELAPSE_OUTPUT_DIR=/home/pi/my-timelapse-data

# ============================================================================
# WEB SERVER OVERRIDES
# ============================================================================

# IP address to listen on
# PITIMELAPSE_WEB_HOST=0.0.0.0

# Port number for the web interface
# PITIMELAPSE_WEB_PORT=8080

# ============================================================================
# CAMERA OVERRIDES
# ============================================================================

# Camera mode: "picamera2" or "opencv"
# PITIMELAPSE_CAMERA_MODE=opencv

# ============================================================================
# CAPTURE OVERRIDES
# ============================================================================

# Seconds between captures
# PITIMELAPSE_INTERVAL_SECONDS=30

# ============================================================================
# LOGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
# PITIMELAPSE_LOG_LEVEL=DEBUG
